// ─── MAIN COLLECTION ──────────────────────────────────────────────────────────
const Collection = () => {
  const [products, setProducts]   = useState([]);
  const [filtered, setFiltered]   = useState([]);
  const [loading, setLoading]     = useState(true);
  const [activeCat, setActiveCat] = useState("all");
  const [viewMode, setViewMode]   = useState("grid4"); // grid4 | grid2 | list
  const [categories, setCategories] = useState(["all"]);

  const API = "https://inf-ct8e.onrender.com/products/fetch";

  useEffect(() => {
    const fetchData = async () => {
      try {
        const res = await fetch(API);
        const data = await res.json();
        const items = data.products || [];
        setProducts(items);
        setFiltered(items);
        // Build unique categories from data
        const cats = ["all", ...new Set(items.map(p => p.category).filter(Boolean))];
        setCategories(cats);
      } catch (err) {
        console.error(err);
        // Use mock data for demo
        const mock = Array(8).fill(0).map((_, i) => ({
          _id: String(i),
          name: ["Cargo Drop Trouser", "Utility Cargo Set", "Slim Fit Jogger", "Oversized Hoodie",
                 "Wide Leg Combo", "Acid Wash Tee", "Tech Fleece Jogger", "Statement Cargo"][i],
          category: ["trousers", "combo", "trousers", "hoodies", "combo", "shirts", "trousers", "combo"][i],
          price: [2800, 5400, 2200, 3600, 4900, 1800, 2600, 5200][i],
          originalPrice: [0, 6500, 0, 4200, 0, 0, 3100, 6000][i] || null,
          isNew: [true, false, false, true, false, true, false, false][i],
          isLimited: [false, true, false, false, true, false, false, true][i],
          image: null,
        }));
        setProducts(mock);
        setFiltered(mock);
        setCategories(["all", "trousers", "combo", "hoodies", "shirts"]);
      } finally {
        setLoading(false);
      }
    };
    fetchData();
  }, []);

  const handleFilter = (cat) => {
    setActiveCat(cat);
    setFiltered(cat === "all" ? products : products.filter(p => p.category === cat));
  };

  const addToCart = (product) => {
    console.log("Added to cart:", product);
  };

  const gridClass = {
    grid4: "",
    grid2: "view-2",
    list:  "view-list",
  }[viewMode];

  return (
    <>
      <style>{styles}</style>

      <section className="collection-page container">

        {/* ── HEADER ── */}
        <div className="collection-header animate-fade-up">
          <div className="collection-eyebrow">SS25 Season</div>
          <h1 className="collection-title">
            The
            <span className="accent">Collection</span>
          </h1>
          <div className="collection-meta">
            <p>Discover the latest drops. Crafted for the streets, built for the bold.</p>
            <div className="collection-count">
              <span className="dot" />
              {loading ? "Loading…" : `${filtered.length} pieces`}
            </div>
          </div>
        </div>

        {/* ── FILTER BAR ── */}
        <div className="filter-bar animate-fade-up delay-1">
          <span className="filter-label">Filter</span>
          {categories.map(cat => (
            <button
              key={cat}
              className={`filter-tag ${activeCat === cat ? "active" : ""}`}
              onClick={() => handleFilter(cat)}
            >
              <span className="tag-dot" />
              {CATEGORY_ICONS[cat] || "◆"} {CATEGORY_LABELS[cat] || cat}
            </button>
          ))}
        </div>

        {/* ── TOOLBAR ── */}
        <div className="collection-toolbar animate-fade-up delay-2">
          <div className="results-info">
            {loading
              ? "Loading products…"
              : <><span>{filtered.length}</span> products found</>
            }
          </div>
          <div className="view-toggle">
            <button
              className={`view-btn ${viewMode === "grid4" ? "active" : ""}`}
              onClick={() => setViewMode("grid4")}
              title="4-column grid"
            >
              <GridIcon4 />
            </button>
            <button
              className={`view-btn ${viewMode === "grid2" ? "active" : ""}`}
              onClick={() => setViewMode("grid2")}
              title="2-column grid"
            >
              <GridIcon2 />
            </button>
            <button
              className={`view-btn ${viewMode === "list" ? "active" : ""}`}
              onClick={() => setViewMode("list")}
              title="List view"
            >
              <ListIcon />
            </button>
          </div>
        </div>

        {/* ── GRID ── */}
        <div className={`collection-grid ${gridClass}`}>
          {loading
            ? Array(8).fill(0).map((_, i) => <SkeletonCard key={i} />)
            : filtered.length === 0
              ? (
                <div className="empty-state">
                  <div className="empty-icon">◎</div>
                  <h3>No pieces found</h3>
                  <p>Try a different filter or check back for new drops.</p>
                </div>
              )
              : filtered.map(product => (
                <ProductCard
                  key={product._id}
                  product={product}
                  addToCart={addToCart}
                  viewMode={viewMode}
                />
              ))
          }
        </div>

      </section>
    </>
  );
};

export default Collection;