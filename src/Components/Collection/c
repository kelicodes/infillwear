// ─── Inline ProductCard ────────────────────────────────────────────────────────
const ProductCard = ({ product, addToCart, viewMode }) => {
  const [wished, setWished] = useState(false);
  const [adding, setAdding] = useState(false);

  const handleAdd = (e) => {
    e.stopPropagation();
    setAdding(true);
    addToCart(product);
    setTimeout(() => setAdding(false), 700);
  };

  const hasDiscount = product.originalPrice && product.originalPrice > product.price;

  return (
    <div className="product-card">
      {/* Badges */}
      <div className="card-badges">
        {product.isNew && <span className="card-badge badge-new">New</span>}
        {hasDiscount && <span className="card-badge badge-sale">Sale</span>}
        {product.isLimited && <span className="card-badge badge-ltd">Ltd</span>}
      </div>

      {/* Image */}
      <div className="card-img-wrap">
        {product.image ? (
          <img src={product.image} alt={product.name} loading="lazy" />
        ) : (
          <div className="card-img-placeholder">
            {(product.name || "?")[0].toUpperCase()}
          </div>
        )}

        {/* Hover overlay */}
        <div className="card-overlay">
          <button className="overlay-btn overlay-btn-cart" onClick={handleAdd}>
            {adding ? "✓ Added" : "Quick Add"}
          </button>
          <button
            className="overlay-btn overlay-btn-wish"
            onClick={(e) => { e.stopPropagation(); setWished(w => !w); }}
            aria-label="Wishlist"
          >
            {wished ? "♥" : "♡"}
          </button>
        </div>
      </div>

      {/* Body */}
      <div className="card-body">
        {product.category && (
          <div className="card-category">{product.category}</div>
        )}
        <div className="card-name">{product.name || "Untitled Product"}</div>
        <div className="card-footer">
          <div>
            <span className={`card-price${hasDiscount ? " card-price-sale" : ""}`}>
              KSh {(product.price || 0).toLocaleString()}
            </span>
            {hasDiscount && (
              <span className="card-price-original">
                KSh {product.originalPrice.toLocaleString()}
              </span>
            )}
          </div>
          <button className="card-add-btn" onClick={handleAdd} aria-label="Add to cart">
            +
          </button>
        </div>
      </div>
    </div>
  );
};

